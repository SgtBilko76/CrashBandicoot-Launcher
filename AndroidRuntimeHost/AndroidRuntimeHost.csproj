<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>io.github.matteo842.crashlauncher.runtime</ApplicationId>
    <ApplicationVersion>15</ApplicationVersion>
    <ApplicationDisplayVersion>2.0.0-beta.1</ApplicationDisplayVersion>
    <AndroidLinkMode>None</AndroidLinkMode>
    <!-- CoreCLR instead of Mono (experimental in .NET 10, warning XA1040). Its
         JIT runs the recompiled game code about twice as fast and the native
         widescreen pass about five times as fast on Quest 3, and the on-device
         Roslyn prepare drops from minutes to under half a minute. Pass
         -p:UseMonoRuntime=true to build the previous Mono APK. -->
    <UseMonoRuntime>false</UseMonoRuntime>
    <!-- CoreCLR Release defaults to ReadyToRun, and SDK 36.1.69 then fails
         (XALNS7015 "Writing mixed-mode assemblies is not supported") when its
         assembly rewriter reaches the R2R images. Everything is JIT-compiled. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Mono only (ignored by CoreCLR): the Mono interpreter does not lower Volatile.ReadBarrier on this path;
         Roslyn and the generated game assembly must run through the Android JIT. -->
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <!-- Release AOT crashes on LibObjectFile (MonoType 0). The game assembly is
         compiled on-device anyway, so profiled AOT of the host is not useful. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- The APK is shared through LocalSend / GitHub, not deployed by an IDE. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
    <!-- Must stay true for Release. Release libmonodroid.so dlopens with a
         hard dependency on compressed_assembly_count in libxamarin-app.so.
         Debug libmonodroid does not, so a Debug APK can look fine while the
         signed Release APK dies in MonoRuntimeProvider before MainActivity. -->
    <AndroidEnableAssemblyCompression>true</AndroidEnableAssemblyCompression>
    <!-- .NET 10 / Android SDK 36 defaults this to true for MonoVM Release.
         That skips JNI RegisterNatives and expects Java_* stubs in
         libxamarin-app.so; if those stubs are missing, open crashes with
         UnsatisfiedLinkError n_onCreate. Debug forces this off (and works).
         The shipping 1.7.0 APK was built with SDK 35 where it defaulted off. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecompOne.Runtime\RecompOne.Runtime.csproj" />
    <ProjectReference Include="..\RecompOne.Recompiler\RecompOne.Recompiler.csproj" />
    <!-- Override the transitive package so its glibc binaries are not packed. -->
    <PackageReference Include="RabbitizerSharp" Version="0.1.0" ExcludeAssets="native" />
    <!-- Desktop host binaries are referenced by the shared core but never used by this host. -->
    <PackageReference Include="ImGui.NET" Version="1.90.8.1" ExcludeAssets="native" />
    <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" ExcludeAssets="native;contentFiles" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" ExcludeAssets="native" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.22.0" ExcludeAssets="build;buildTransitive;native" />
  </ItemGroup>

  <!-- Meta Quest: libcrashxr.so presents the game through OpenXR. It is built
       from source with the NDK the Android SDK resolves; the Khronos loader
       it links against ships prebuilt in Native/arm64-v8a. -->
  <PropertyGroup>
    <CrashXrSource>$(MSBuildProjectDirectory)/QuestVr/Native/crashxr.c</CrashXrSource>
    <CrashXrOutput>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)crashxr/arm64-v8a/libcrashxr.so</CrashXrOutput>
  </PropertyGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="$(CrashXrOutput)" Abi="arm64-v8a" />
  </ItemGroup>

  <Target Name="BuildCrashXr" BeforeTargets="BeforeBuild" DependsOnTargets="_ResolveSdks"
          Inputs="$(CrashXrSource)" Outputs="$(CrashXrOutput)">
    <PropertyGroup>
      <_CrashXrNdk>$(_AndroidNdkDirectory)</_CrashXrNdk>
      <_CrashXrNdk Condition="'$(_CrashXrNdk)' == ''">$(AndroidNdkDirectory)</_CrashXrNdk>
      <_CrashXrHost Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows-x86_64</_CrashXrHost>
      <_CrashXrHost Condition="$([MSBuild]::IsOSPlatform('OSX'))">darwin-x86_64</_CrashXrHost>
      <_CrashXrHost Condition="'$(_CrashXrHost)' == ''">linux-x86_64</_CrashXrHost>
      <_CrashXrClang>$([MSBuild]::EnsureTrailingSlash($(_CrashXrNdk)))toolchains/llvm/prebuilt/$(_CrashXrHost)/bin/aarch64-linux-android29-clang</_CrashXrClang>
      <_CrashXrClang Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(_CrashXrClang).cmd</_CrashXrClang>
    </PropertyGroup>
    <Error Condition="'$(_CrashXrNdk)' == '' Or !Exists('$(_CrashXrClang)')"
           Text="The Android NDK is required to build the Meta Quest presenter (libcrashxr.so). Install it from the Android SDK manager." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(CrashXrOutput)'))" />
    <Exec Command="&quot;$(_CrashXrClang)&quot; -shared -fPIC -O2 -fvisibility=hidden -I&quot;$(MSBuildProjectDirectory)/QuestVr/Native/include&quot; &quot;$(CrashXrSource)&quot; -L&quot;$(MSBuildProjectDirectory)/Native/arm64-v8a&quot; -lopenxr_loader -lEGL -lGLESv3 -llog -lm -Wl,-z,max-page-size=16384 -o &quot;$(CrashXrOutput)&quot;" />
  </Target>

  <ItemGroup>
    <Compile Include="..\CrashBandicoot.Launcher\Recomp\DiscValidator.cs" Link="Shared\DiscValidator.cs" />
    <Compile Include="..\CrashBandicoot.Launcher\Recomp\GameCompiler.cs" Link="Shared\GameCompiler.cs" />
    <Compile Include="..\CrashBandicoot.Launcher\Recomp\GameLoader.cs" Link="Shared\GameLoader.cs" />
    <Compile Include="..\CrashBandicoot.Launcher\Recomp\PostPassApplier.cs" Link="Shared\PostPassApplier.cs" />
    <Compile Include="..\CrashBandicoot.Launcher\Recomp\RecompRunner.cs" Link="Shared\RecompRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" />
    <AndroidResource Include="..\icon.png" Link="Resources\drawable\app_icon.png" />
    <AndroidAsset Include="..\CrashBandicoot.Launcher\Ui\fonts\Bungee-Regular.ttf"
                  Link="Fonts\Bungee-Regular.ttf" />
    <AndroidAsset Include="..\CrashBandicoot.Launcher\Ui\fonts\Nunito-ExtraBold.ttf"
                  Link="Fonts\Nunito-ExtraBold.ttf" />
    <AndroidAsset Include="..\CrashBandicoot.Launcher\Ui\fonts\Nunito-SemiBold.ttf"
                  Link="Fonts\Nunito-SemiBold.ttf" />
    <AndroidAsset Include="..\CrashBandicoot.Launcher\Ui\world_map.png"
                  Link="Images\world_map.png" />
    <AndroidAsset Include="..\CrashBandicoot.Launcher\Recomp\CrashBandicoot.json"
                  Link="Recomp\CrashBandicoot.json" />
    <AndroidAsset Include="..\CrashBandicoot.Launcher\Recomp\Patches\main.cs.patch"
                  Link="Recomp\Patches\main.cs.patch" />
    <AndroidAsset Include="..\examples\mods\auto-spin\mod.json"
                  Link="ExampleMods\auto-spin\mod.json" />
    <AndroidAsset Include="..\examples\mods\auto-spin\AutoSpinMod.cs"
                  Link="ExampleMods\auto-spin\AutoSpinMod.cs" />
    <!-- Roslyn needs reference assemblies as real files on Android. -->
    <AndroidAsset Include="$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Ref\10.0.*\ref\net10.0\*.dll"
                  Link="CompilerRefs\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\RecompOne.Runtime\bin\$(Configuration)\net10.0\RecompOne.Runtime.dll"
                  Link="CompilerRefs\RecompOne.Runtime.dll" />
  </ItemGroup>
</Project>
